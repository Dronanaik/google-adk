# Gemini Developer API (AI Studio) — NOT Vertex
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# The Gemini Live model + Aria's native voice
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Aoede

# CSM Policy Gate settings (driven by csm_agent/policy.py)
# Maximum automatic refund amount in USD before the policy gate blocks & requires human/ticket escalation
MAX_AUTO_REFUND=100.0
# Set REQUIRE_PIN=1 to block mutations (refunds, address changes, cancellations) until verify_customer_pin succeeds
REQUIRE_PIN=0
# Set STRICT_REFUND_WINDOW=1 to block refunds on orders delivered more than 30 days ago (default: 1)
STRICT_REFUND_WINDOW=1

# Optional — silences ADK OpenTelemetry chatter
OTEL_SDK_DISABLED=true

